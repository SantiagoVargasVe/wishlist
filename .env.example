# Copy to .env and fill in. NEVER commit .env.
# On a server, keep it next to docker-compose.yml with chmod 600.

# --- Database ---
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=wishlist
DATABASE_URL=postgresql://wishlist:change-me-long-random@localhost:5432/wishlist

# Integration tests only — the app never reads this, so it is not in the config
# schema. Must be a SEPARATE database: the suite drops and recreates the public
# schema, which would wipe your development data.
DATABASE_URL_TEST=postgresql://wishlist:change-me-long-random@localhost:5432/wishlist_test

# --- Auth ---
# 32+ random bytes:  openssl rand -base64 48
AUTH_SECRET=change-me-openssl-rand-base64-48
AUTH_COOKIE_NAME=wishlist_session
AUTH_TOKEN_TTL_DAYS=30

# --- App ---
# Public origin. Used for share links and OG metadata absolute URLs.
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Media ---
IMAGE_STORAGE_PATH=./data/images
IMAGE_MAX_WIDTH=800
IMAGE_WEBP_QUALITY=80

# --- Scraping ---
OG_FETCH_TIMEOUT_MS=5000
OG_MAX_HTML_BYTES=2097152
OG_MAX_IMAGE_BYTES=10485760
OG_CACHE_TTL_HOURS=168
# Several retailers' CDNs allow only link-preview crawlers through to their
# origin, deciding on User-Agent alone: a bot-shaped string gets a 403 and a
# browser-shaped one gets an unsolvable JS challenge. See ADR-0010 for the
# measurements and the tradeoff involved. Set this to `WishlistBot/1.0` to
# identify honestly and accept that those sites won't produce a preview.
OG_USER_AGENT=WhatsApp/2.0 (+https://github.com/SantiagoVargasVe/wishlist)

# Optional — commented out, not blank: an empty value is present-but-empty,
# which the schema rejects the same as a too-short secret, whereas a genuinely
# absent key is fine. MercadoLibre catalog-product links (.../p/MCO...) only
# resolve via their API when both are uncommented and set — client_credentials
# app, developers.mercadolibre.com.<tld>. Left as-is, MercadoLibre links fall
# through to the generic scrape above (T036).
# MELI_CLIENT_ID=your-app-id
# MELI_CLIENT_SECRET=your-secret-key
